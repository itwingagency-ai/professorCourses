# Backend Docker Environment Variables
PORT=8000
ORIGIN=http://localhost:3000
NODE_ENV=development

# Database URIs
DB_URL=mongodb://mongo:27017/lms
REDIS_URL=redis://redis:6379

# Secrets (DO NOT COMMIT REAL VALUES)
ACTIVATION_SECRET=change_me_activation_secret
ACCESS_TOKEN=change_me_access_token
REFRESH_TOKEN=change_me_refresh_token
ACCESS_TOKEN_EXPIRE=5
REFRESH_TOKEN_EXPIRE=3

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# External APIs
VDOCIPHER_API_SECRET=your_vdocipher_secret
STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_key
CLOUD_SECRET_KEY=your_cloud_secret
