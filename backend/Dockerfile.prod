# Build stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Production stage
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
RUN npm install --omit=dev

# Copy compiled js
COPY --from=builder /app/dist ./dist

# Copy ejs templates to dist so relative paths work
COPY --from=builder /app/mails ./dist/mails

USER node

EXPOSE 8000
CMD ["npm", "start"]
